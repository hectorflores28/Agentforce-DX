    {
      "parameters": {
        "jsCode": "const item = $input.item;\nconst rawOutput = item.json.output;\n// Extraer el Session ID nativo recibido desde el webhook\nconst sessionId = $node[\"When chat message received\"].json.sessionId;\n\n// Objeto base con estructura por defecto (Fallback seguro)\nlet finalizedData = {\n  session_id: sessionId,\n  intent: \"Otros\",\n  requiere_escalacion: false,\n  cliente_nombre: \"Desconocido\",\n  cliente_telefono: \"No proporcionado\",\n  motivo: \"Conversación general\",\n  propiedad: \"Grand xxx\",\n  respuesta: rawOutput\n};\n\nif (typeof rawOutput === 'string') {\n  // Guardrail: Buscar patrones JSON dentro del texto por si el modelo metió explicaciones\n  const jsonMatch = rawOutput.match(/\\{[\\s\\S]*\\}/);\n  \n  if (jsonMatch) {\n    try {\n      const cleanJson = JSON.parse(jsonMatch[0]);\n      // Combinar los datos del LLM sobre la estructura base\n      finalizedData = { ...finalizedData, ...cleanJson };\n    } catch (e) {\n      console.error(\"No se pudo parsear el JSON del LLM, usando fallback de texto plano.\");\n    }\n  }\n} else if (typeof rawOutput === 'object') {\n  finalizedData = { ...finalizedData, ...rawOutput };\n}\n\n// Convertir booleanos explícitamente a enteros (1 o 0) para compatibilidad estricta con MySQL TINYINT\nfinalizedData.escalated_to_human = finalizedData.requiere_escalacion ? 1 : 0;\nfinalizedData.handled_by_bot = finalizedData.requiere_escalacion ? 0 : 1;\n\nreturn { json: finalizedData };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        112
      ],
      "id": "1674ce5e-8a8c-459a-85bc-c18679db906d",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Paso 1: Asegurar la existencia de la sesión en la tabla parental aplicando ON DUPLICATE KEY UPDATE\nINSERT INTO sessions (\n    session_id, \n    session_date, \n    property, \n    handled_by_bot, \n    escalated_to_human, \n    ai_summary\n)\nVALUES (\n    '{{ $json.session_id }}',\n    CURDATE(),\n    '{{ $json.propiedad }}',\n    {{ $json.handled_by_bot }},\n    {{ $json.escalated_to_human }},\n    '{{ $json.motivo }}'\n)\nON DUPLICATE KEY UPDATE \n    property = VALUES(property),\n    handled_by_bot = VALUES(handled_by_bot),\n    escalated_to_human = VALUES(escalated_to_human),\n    ai_summary = VALUES(ai_summary);\n\n-- Paso 2: Registrar el mensaje correspondiente en la tabla secundaria dependiente\nINSERT INTO messages (\n    session_id, \n    sender_type, \n    sender_name, \n    message_text\n)\nVALUES (\n    '{{ $json.session_id }}',\n    'SISTEMA',\n    'AI_Bot',\n    '{{ $json.respuesta }}'\n);",
        "options": {}
      },
